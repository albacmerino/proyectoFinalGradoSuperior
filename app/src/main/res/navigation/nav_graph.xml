<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/nav_graph"
        app:startDestination="@id/splashFragment">

    <!-- Pantalla 1: SPLASH -->
    <fragment
            android:id="@+id/splashFragment"
            android:name="org.dam2.appstreaming.ui.screen.splash.SplashFragment"
            android:label="Splash"
            tools:layout="@layout/fragment_splash">

        <!-- Esta es la acción que falta o tiene el nombre mal -->
        <action
                android:id="@+id/action_splashFragment_to_loginFragment"
                app:destination="@id/loginFragment"
                app:popUpTo="@id/splashFragment"
                app:popUpToInclusive="true" />
    </fragment>

    <!-- Pantalla 2: LOGIN -->
    <fragment
            android:id="@+id/loginFragment"
            android:name="org.dam2.appstreaming.ui.screen.auth.LoginFragment"
            android:label="Login">
        <action
                android:id="@+id/action_loginFragment_to_homeFragment"
                app:destination="@id/homeFragment" />
    </fragment>

    <!-- Pantalla 3: HOME -->
    <fragment
            android:id="@+id/homeFragment"
            android:name="org.dam2.appstreaming.ui.screen.home.HomeFragment"
            android:label="Home" />

</navigation>