<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/nav_graph"
        app:startDestination="@id/splashFragment">

    <!-- Pantalla 1: SPLASH -->
    <fragment
            android:id="@+id/splashFragment"
            android:name="org.dam2.appstreaming.ui.screen.splash.SplashFragment"
            android:label="Splash">
        <action
                android:id="@+id/action_splashFragment_to_loginFragment"
                app:destination="@id/loginFragment"
                app:enterAnim="@anim/slide_in_right"
                app:exitAnim="@anim/slide_out_left"
                app:popUpTo="@id/splashFragment"
                app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Pantalla 2: LOGIN -->
    <fragment
            android:id="@+id/loginFragment"
            android:name="org.dam2.appstreaming.ui.screen.auth.LoginFragment"
            android:label="Login">

        <!-- Transición al Home -->
        <action
                android:id="@+id/action_loginFragment_to_homeFragment"
                app:destination="@id/homeFragment"
                app:enterAnim="@anim/slide_in_right"
                app:exitAnim="@anim/slide_out_left"
                app:popEnterAnim="@android:anim/slide_in_left"
                app:popExitAnim="@android:anim/slide_out_right"
                app:popUpTo="@id/loginFragment"
                app:popUpToInclusive="true"
                />
        <!--Transición a recuperar contraseña -->
        <action
            android:id="@+id/action_loginFragment_to_forgotPasswordFragment"
            app:destination="@id/forgotPasswordFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@android:anim/slide_in_left"
            app:popExitAnim="@android:anim/slide_out_right" />


        <!-- Transición al Registro -->
        <action
                android:id="@+id/action_loginFragment_to_registerFragment"
                app:destination="@id/registerFragment"
                app:enterAnim="@anim/slide_in_right"
                app:exitAnim="@anim/slide_out_left"
                app:popEnterAnim="@android:anim/slide_in_left"
                app:popExitAnim="@android:anim/slide_out_right" />
    </fragment>

    <!-- Pantalla 3: HOME -->
    <fragment
            android:id="@+id/homeFragment"
            android:name="org.dam2.appstreaming.ui.screen.home.HomeFragment"
            android:label="Home">

        <action
                android:id="@+id/action_homeFragment_to_peliculaDetailFragment"
                app:destination="@id/peliculaDetailFragment"
                app:enterAnim="@anim/slide_in_right"
                app:exitAnim="@anim/slide_out_left"
                app:popEnterAnim="@android:anim/slide_in_left"
                app:popExitAnim="@android:anim/slide_out_right"/>

        <action
                android:id="@+id/action_homeFragment_to_serieDetailFragment"
                app:destination="@id/serieDetailFragment"
                app:enterAnim="@anim/slide_in_right"
                app:exitAnim="@anim/slide_out_left"
                app:popEnterAnim="@android:anim/slide_in_left"
                app:popExitAnim="@android:anim/slide_out_right" />

        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>


    <fragment
            android:id="@+id/peliculaDetailFragment"
            android:name="org.dam2.appstreaming.ui.screen.pelicula.PeliculaDetailFragment">
        <action
                android:id="@+id/action_peliculaDetailFragment_to_reviewsFragment"
                app:destination="@id/reviewsFragment"
                app:enterAnim="@anim/slide_in_right"
                app:exitAnim="@anim/slide_out_left"
                app:popEnterAnim="@android:anim/slide_in_left"
                app:popExitAnim="@android:anim/slide_out_right" />
    </fragment>

    <fragment
            android:id="@+id/serieDetailFragment"
            android:name="org.dam2.appstreaming.ui.screen.serie.SerieDetailFragment">
        <action
                android:id="@+id/action_serieDetailFragment_to_reviewsFragment"
                app:destination="@id/reviewsFragment"
                app:enterAnim="@anim/slide_in_right"
                app:exitAnim="@anim/slide_out_left"
                app:popEnterAnim="@android:anim/slide_in_left"
                app:popExitAnim="@android:anim/slide_out_right" />
    </fragment>

    <fragment
            android:id="@+id/reviewsFragment"
            android:name="org.dam2.appstreaming.ui.screen.reviews.ReviewsFragment">
        <argument
                android:name="mediaType"
                app:argType="string" />
    </fragment>

    <!-- Pantalla 4: REGISTER -->
    <fragment
            android:id="@+id/registerFragment"
            android:name="org.dam2.appstreaming.ui.screen.auth.RegisterFragment"
            android:label="Register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:enterAnim="@android:anim/slide_in_left"
            app:exitAnim="@android:anim/slide_out_right"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="org.dam2.appstreaming.ui.screen.auth.ForgotPasswordFragment"
        android:label="Recuperar Contraseña" />


</navigation>
